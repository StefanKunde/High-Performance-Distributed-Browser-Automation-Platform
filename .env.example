# ============================================================================
# Data Processing Platform Configuration
# ============================================================================
# This is a portfolio demonstration project showcasing distributed system
# architecture and real-time data processing capabilities.
# ============================================================================

# ============================================================================
# API ENDPOINT CONFIGURATION
# ============================================================================
# Configure the target API service endpoints
API_ORIGIN=https://api.example-service.local
API_DOMAIN=api.example-service.local
API_COOKIE_DOMAIN=.example-service.local
GRAPHQL_URL=https://api.example-service.local/graphql
SITE_URL=https://app.example-service.local/
WS_URL=wss://api.example-service.local/ws

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Session/Auth token (obtained after login to target service)
SESSION_ID=your_session_token_here

# ============================================================================
# PROCESSING LIMITS CONFIGURATION
# ============================================================================
# Maximum value threshold for data processing operations
MAX_PROCESSING_VALUE=500

# Minimum value threshold for data processing operations
MIN_PROCESSING_VALUE=35

# Maximum percentage markup for value calculations (e.g., 4 = 4%)
MAX_MARKUP_PERCENT=4

# Filter items by name (JSON array format, optional)
# Example: ["Item1","Item2","Item3"]
FILTER_ITEMS_JSON=[]

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================
# Enable/disable proxy usage (0=disabled, 1=enabled)
USE_PROXY=0

# Proxy server URL (if enabled)
# Format: http://host:port or socks5://host:port
PROXY_SERVER=http://localhost:3128

# Proxy authentication credentials (if required)
PROXY_USERNAME=user
PROXY_PASSWORD=password

# Listen port for UDP notifications (cluster mode)
UDP_PORT=9999

# Worker service address (optional, for distributed setup)
WORKER_SERVICE_IP=
WORKER_SERVICE_PORT=12345

# ============================================================================
# TOKEN SERVICE CONFIGURATION
# ============================================================================
# Service URL for obtaining authentication tokens
TOKEN_SERVICE_URL=http://localhost:4300/get-token

# ============================================================================
# BROWSER CONFIGURATION
# ============================================================================
# Browser user agent string (for client compatibility testing)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36

# ============================================================================
# TRACKING & ANALYTICS (OPTIONAL)
# ============================================================================
# Backend URL for operation tracking/analytics (optional, can be disabled)
TRACKING_BACKEND_URL=

# ============================================================================
# PROCESSING SERVICE IPC
# ============================================================================
# Unix domain socket path for processing service communication
PROCESSING_SERVICE_SOCKET=/tmp/processor.sock

# ============================================================================
# PORT CONFIGURATION
# ============================================================================
SERVICE_GRPC_PORT=50051

# ============================================================================
# NOTES
# ============================================================================
# 1. Copy this file to .env and configure your values
# 2. SESSION_ID is REQUIRED for authenticated operations
# 3. UDP_PORT must match the service port in multi-instance setups
# 4. Proxy is optional; disable with USE_PROXY=0 for direct connections
# 5. Token service must be running separately if authentication is required
# 6. This is a demonstration project showcasing distributed architecture
